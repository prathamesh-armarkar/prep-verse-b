# ==========================================
# PrepVerse Backend Environment Variables
# ==========================================

# ---------- Flask / JWT ----------
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# ---------- MongoDB (replaces MySQL after migration) ----------
# Local: mongodb://localhost:27017/prepverse
# Atlas: mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/prepverse
MONGO_DBNAME=prepverse

# ---------- File Uploads ----------
# Public base URL used to build absolute URLs for uploaded files
PUBLIC_BASE_URL=https://prep-verse-b.onrender.com

# ---------- Email (Flask-Mail / Gmail SMTP) ----------
MAIL_EMAIL=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ---------- Groq AI (Resume Analysis) ----------
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2400
GROQ_INPUT_CHARS=7000
GROQ_CACHE_TTL=3600

